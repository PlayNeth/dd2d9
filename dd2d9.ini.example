; dd2d9 configuration
; Global location: C:\windows\dd2d9.ini  (in a Wine prefix: drive_c/windows/dd2d9.ini)
; Also read, in order (later wins): <ddraw.dll dir>\dd2d9.ini, <game dir>\dd2d9.ini,
; and the file named by the DD2D9_INI environment variable. DD2D9_LOG overrides "log".
;
; Keys outside a section, in [dd2d9] and in [default] apply to every game; a [game.exe]
; section overrides them for that executable only (case-insensitive).
; The defaults behave like the original DirectDraw.

[default]
; What exclusive fullscreen games get:
;   switch     - change the display mode, as DirectDraw does (default). If the monitor
;                lacks the mode (320x200, 320x240...), falls back to borderless.
;   window     - no mode change: a window the size of the game's mode, centered
;   borderless - no mode change: a borderless window covering the monitor, image scaled
display=switch

; Scaling when the image doesn't fit 1:1 (window resized, borderless, windowed games):
;   aspect (default), fill, integer
stretch=aspect

; Scaling filter:
;   point  - sharp pixels, but uneven at non-integer scales (default)
;   linear - smooth, but blurry
;   sharp  - in between (also bilinear-sharp): scaled up to the nearest whole multiple
;            with sharp pixels, then smoothly the rest of the way; crisp, with only a
;            one-pixel soft edge
filter=point

; Vertical sync:
;   auto - the game decides: Flip() waits for vblank unless the game passes DDFLIP_NOVSYNC,
;          as DirectDraw does (default)
;   on   - every Flip() waits for vblank
;   off  - never wait (uncapped, may tear)
vsync=auto

; Direct3D (3D games):
;   auto - dd2d9's own Direct3D 3-7, drawn through Direct3D 9 (default); on is the same
;   off  - no Direct3D at all: games use their 2D or software renderers
d3d=auto

; The mouse, when the game's display mode is shown scaled or in a window (display=borderless
; or window, or a mode the monitor lacks):
;   scale - the game sees the cursor in its own mode's coordinates, as if that mode filled the
;           screen: its window is its screen, at 0,0 (default)
;   raw   - the real screen's coordinates (clicks land in the wrong place when scaled)
mouse=scale

; Which d3d9.dll dd2d9 draws and presents through:
;   system - Windows' own, even when the game folder holds another one (DXVK's).
;            Presenting through DXVK's Vulkan in a window that covers the screen
;            can let the driver take over the display and switch it back to the desktop
;            resolution, which drops games out of fullscreen (default)
;   game   - the one the game loads (the game folder's, if there is one)
d3d9=system

; Compatibility: what the game is told about the machine, as a PC of its era would answer.
; Memory in MB (GlobalMemoryStatus). Windows tells programs that aren't large-address-aware
; there are 2 GB of memory and 4 GB of page file, and games of the era overflow adding to
; that and say there isn't enough memory. 0: the real values. At most 2047.
ram=1024
; Video memory in MB that DirectDraw reports (GetCaps, GetAvailableVidMem): 1 to 2047.
; Try 128 or 256 if a game complains about it.
vram=512
; Processor clock in MHz in the registry (~MHz): 2000 (default), as fast as the PCs of the
; era got. Games that time the processor themselves (RDTSC) still see the real one. A game
; that times itself with the registry's figure runs at the wrong speed: set 0 (the real
; clock) for it.
cpu=2000
; Processors the game runs on and is told about (GetSystemInfo): 1 (default), as the PCs of
; the era had; games of the era can crash, stutter or run at the wrong speed on several.
; 0: all.
cpus=1

; Logging: 0 off (default), 1 info, 2 trace (every blit, lock, flip and palette change -
; very verbose, for diagnosing rendering problems).
; With log=1 or more, calls dd2d9 doesn't support are logged too ("stub: ...").
log=0
; Default log file: dd2d9.log next to the game's exe. If that folder isn't writable, dd2d9
; falls back to the current directory, then %TEMP%. A relative path is relative to the
; game's folder. The environment variable DD2D9_LOG=<path> also sets it.
;logfile=Z:\tmp\dd2d9.log

; Per-game example:
;[claw.exe]
;log=2
;logfile=Z:\tmp\claw-dd2d9.log
